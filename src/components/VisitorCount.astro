---
const pathname = Astro.props.pathname
---

<script define:vars={{ pathname }}>
	const r = new XMLHttpRequest()
	
	r.addEventListener("load", function() {
		const { count_unique } = JSON.parse(this.responseText)
        document.querySelector("#visitor-count").innerText = `${count_unique} visitor${count_unique == 1 ? "" : "s"} viewed this page`
    })

    r.open("GET", `https://stats.dandelion.computer/counter/${encodeURIComponent(pathname)}.json`)
    r.send()
</script>

<a id="visitor-count" href={`https://stats.dandelion.computer?filter=${encodeURIComponent(`${pathname} at:start at:end`)}`}>see how many visitors viewed this page</a>
